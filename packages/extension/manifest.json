{
  "manifest_version": 3,
  "name": "sightkick",
  "version": "0.0.1",
  "description": "Inject sightkick WebMCP tools (generated from sightmap corpora) into third-party sites.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "sightkick" },
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "web_accessible_resources": [
    {
      "resources": ["sightkick-runtime.js", "corpora/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
