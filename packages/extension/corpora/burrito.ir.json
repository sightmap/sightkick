{
  "version": 1,
  "name": "burrito",
  "views": [
    {
      "name": "MenuView",
      "route": "/"
    },
    {
      "name": "ItemDetailView",
      "route": "/items/**"
    },
    {
      "name": "CartView",
      "route": "/cart"
    },
    {
      "name": "CheckoutView",
      "route": "/checkout"
    },
    {
      "name": "ConfirmationView",
      "route": "/confirmation"
    }
  ],
  "tools": [
    {
      "name": "list_menu",
      "description": "List the menu items (name + price).",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "MenuView",
        "route": "/"
      },
      "steps": [
        {
          "op": "collect",
          "query": {
            "parts": [
              {
                "locators": [
                  ".menu-card"
                ]
              }
            ]
          },
          "fields": {
            "item": {
              "property": "itemName",
              "extractor": {
                "kind": "text",
                "within": ".menu-card-name"
              }
            },
            "price": {
              "property": "price",
              "extractor": {
                "kind": "text",
                "within": ".menu-card-price"
              }
            }
          }
        }
      ],
      "guidance": [
        {
          "tool": "open_item",
          "reason": "open an item to customize it",
          "when": "now"
        }
      ]
    },
    {
      "name": "open_item",
      "description": "Open a menu item's detail page to customize it. Navigates to the item view.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "The exact menu item name (see list_menu)."
          }
        },
        "required": [
          "item"
        ]
      },
      "ensureView": {
        "view": "MenuView",
        "route": "/"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".menu-card"
                ],
                "preds": [
                  {
                    "property": "itemName",
                    "extractor": {
                      "kind": "text",
                      "within": ".menu-card-name"
                    },
                    "op": "=",
                    "value": "{{item}}"
                  }
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "choose_option",
          "reason": "customize the item",
          "when": "after_navigation",
          "view": "ItemDetailView"
        }
      ]
    },
    {
      "name": "choose_option",
      "description": "Pick a customization option within a group on the item detail page (e.g. group \"Protein\", option \"steak\"). Scoped by group so repeated labels like \"none\" are unambiguous.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "description": "The option group (Protein, Rice, Beans, Salsa, Extras)."
          },
          "option": {
            "type": "string",
            "description": "The option label within that group (e.g. steak, white, none, guacamole)."
          }
        },
        "required": [
          "group",
          "option"
        ]
      },
      "ensureView": {
        "view": "ItemDetailView",
        "route": "/items/**"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".option-group"
                ],
                "preds": [
                  {
                    "property": "name",
                    "extractor": {
                      "kind": "text",
                      "within": ".option-group-label"
                    },
                    "op": "=",
                    "value": "{{group}}",
                    "ci": true
                  }
                ]
              },
              {
                "locators": [
                  ".option-group .option-button"
                ],
                "preds": [
                  {
                    "property": "label",
                    "extractor": {
                      "kind": "text"
                    },
                    "op": "=",
                    "value": "{{option}}",
                    "ci": true
                  }
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "add_to_cart",
          "reason": "add the customized item to the cart",
          "when": "now"
        }
      ]
    },
    {
      "name": "add_to_cart",
      "description": "Add the customized item to the cart. Navigates to the cart.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "ItemDetailView",
        "route": "/items/**"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".item-detail-view .item-detail-add"
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "view_cart",
          "reason": "review the cart",
          "when": "after_navigation",
          "view": "CartView"
        }
      ]
    },
    {
      "name": "set_field",
      "description": "Fill a checkout field by its label. The checkout form is pre-filled, so this is only needed to change a value.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The field label (Street, City, State, ZIP, Card number, Expiry, CVC)."
          },
          "value": {
            "type": "string",
            "description": "The value to enter."
          }
        },
        "required": [
          "field",
          "value"
        ]
      },
      "ensureView": {
        "view": "CheckoutView",
        "route": "/checkout"
      },
      "steps": [
        {
          "op": "fill",
          "query": {
            "parts": [
              {
                "locators": [
                  ".text-field"
                ],
                "preds": [
                  {
                    "property": "label",
                    "extractor": {
                      "kind": "text",
                      "within": ".text-field-label"
                    },
                    "op": "=",
                    "value": "{{field}}",
                    "ci": true
                  }
                ]
              },
              {
                "locators": [
                  ".text-field .text-field-input"
                ]
              }
            ]
          },
          "value": "{{value}}"
        }
      ]
    },
    {
      "name": "view_cart",
      "description": "List the items currently in the cart.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "CartView",
        "route": "/cart"
      },
      "steps": [
        {
          "op": "collect",
          "query": {
            "parts": [
              {
                "locators": [
                  ".cart-line"
                ]
              }
            ]
          },
          "fields": {
            "name": {
              "property": "name",
              "extractor": {
                "kind": "text",
                "within": ".cart-line-name"
              }
            }
          }
        }
      ],
      "guidance": [
        {
          "tool": "go_to_checkout",
          "reason": "proceed to checkout",
          "when": "now"
        }
      ]
    },
    {
      "name": "go_to_checkout",
      "description": "Proceed from the cart to checkout. Navigates to the checkout page.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "CartView",
        "route": "/cart"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".order-summary .order-summary-cta"
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "place_order",
          "reason": "place the order",
          "when": "after_navigation",
          "view": "CheckoutView"
        }
      ]
    },
    {
      "name": "place_order",
      "description": "Place the order from checkout (the form is pre-filled). Navigates to the confirmation page and returns the order id.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "CheckoutView",
        "route": "/checkout"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".order-summary .order-summary-cta"
                ]
              }
            ]
          }
        },
        {
          "op": "waitFor",
          "query": {
            "parts": [
              {
                "locators": [
                  ".confirmation-order-id"
                ]
              }
            ]
          },
          "timeoutMs": 5000
        }
      ],
      "returns": {
        "description": "The order confirmation id.",
        "kind": "value",
        "query": {
          "parts": [
            {
              "locators": [
                ".confirmation-order-id"
              ]
            }
          ]
        },
        "extractor": {
          "kind": "text"
        }
      }
    }
  ]
}
