{
  "version": 1,
  "name": "jetblue",
  "views": [
    {
      "name": "Cart",
      "route": "/booking/cart"
    },
    {
      "name": "Checkout",
      "route": "/booking/checkout"
    },
    {
      "name": "Home",
      "route": "/"
    },
    {
      "name": "SelectFlights",
      "route": "/booking/flights"
    }
  ],
  "tools": [
    {
      "name": "search_flights",
      "description": "Search round-trip JetBlue flights by deep-linking to the results page for the given airports and dates. Use IATA airport codes and ISO (YYYY-MM-DD) dates.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "depart_date": {
            "type": "string",
            "description": "Departure date, ISO format YYYY-MM-DD, e.g. \"2026-09-15\"."
          },
          "destination": {
            "type": "string",
            "description": "Destination IATA airport code, e.g. \"LAX\"."
          },
          "origin": {
            "type": "string",
            "description": "Origin IATA airport code, e.g. \"JFK\"."
          },
          "return_date": {
            "type": "string",
            "description": "Return date, ISO format YYYY-MM-DD, e.g. \"2026-09-22\"."
          }
        },
        "required": [
          "origin",
          "destination",
          "depart_date",
          "return_date"
        ]
      },
      "ensureView": {
        "view": "Home",
        "route": "/"
      },
      "steps": [
        {
          "op": "goto",
          "url": "https://www.jetblue.com/booking/flights?from={{origin}}\u0026to={{destination}}\u0026depart={{depart_date}}\u0026return={{return_date}}\u0026adults=1\u0026children=0\u0026infants=0\u0026isMultiCity=false\u0026usePoints=false"
        }
      ],
      "guidance": [
        {
          "tool": "list_flights",
          "reason": "read the itineraries the search produced",
          "when": "after_navigation",
          "view": "SelectFlights"
        }
      ]
    },
    {
      "name": "list_flights",
      "description": "List the flight itineraries in the current results — flight number, stops, and duration. Returns `items`: a list of objects with keys {duration, flight_no, stops}. The current flight itineraries.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "SelectFlights",
        "route": "/booking/flights"
      },
      "steps": [],
      "returns": {
        "description": "The current flight itineraries.",
        "kind": "list",
        "query": {
          "parts": [
            {
              "locators": [
                "cb-flight-result-item"
              ]
            }
          ]
        },
        "fields": {
          "duration": {
            "property": "duration",
            "extractor": {
              "kind": "text",
              "within": ".flight-panel__duration"
            }
          },
          "flight_no": {
            "property": "flight_no",
            "extractor": {
              "kind": "text",
              "within": ".flight-codes"
            }
          },
          "stops": {
            "property": "stops",
            "extractor": {
              "kind": "text",
              "within": ".flight-panel__stops"
            }
          }
        }
      },
      "guidance": [
        {
          "tool": "select_fare",
          "reason": "pick a fare cabin for the depart leg (and again for the return list)",
          "when": "now"
        }
      ]
    },
    {
      "name": "list_fares",
      "description": "List every fare option across the current results — cabin and price. Returns `items`: a list of objects with keys {cabin, price}. The fare options offered on the current results.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "SelectFlights",
        "route": "/booking/flights"
      },
      "steps": [],
      "returns": {
        "description": "The fare options offered on the current results.",
        "kind": "list",
        "query": {
          "parts": [
            {
              "locators": [
                "cb-flight-result-item jb-card.cb-fare-card"
              ]
            }
          ]
        },
        "fields": {
          "cabin": {
            "property": "cabin",
            "extractor": {
              "kind": "text",
              "within": ".body"
            }
          },
          "price": {
            "property": "price",
            "extractor": {
              "kind": "text",
              "within": ".cb-bundle-price__price"
            }
          }
        }
      }
    },
    {
      "name": "select_fare",
      "description": "Select a fare cabin (Main, EvenMore, or Mint) on a specific flight, identified by its flight number (e.g. \"B6 123\"). Scopes to the matching flight card, then clicks the requested fare.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cabin": {
            "type": "string",
            "description": "Fare cabin — one of \"Main\", \"EvenMore\", \"Mint\"."
          },
          "flight": {
            "type": "string",
            "description": "Flight number to select on, e.g. \"B6 123\"."
          }
        },
        "required": [
          "flight",
          "cabin"
        ]
      },
      "ensureView": {
        "view": "SelectFlights",
        "route": "/booking/flights"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  "cb-flight-result-item"
                ],
                "preds": [
                  {
                    "property": "flight_no",
                    "extractor": {
                      "kind": "text",
                      "within": ".flight-codes"
                    },
                    "op": "*=",
                    "value": "{{flight}}"
                  }
                ]
              },
              {
                "locators": [
                  "cb-flight-result-item jb-card.cb-fare-card"
                ],
                "preds": [
                  {
                    "property": "label",
                    "extractor": {
                      "kind": "text"
                    },
                    "op": "*=",
                    "value": "{{cabin}}"
                  }
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "list_cart",
          "reason": "review both selected legs before checkout",
          "when": "after_navigation",
          "view": "Cart"
        }
      ]
    },
    {
      "name": "sort_results",
      "description": "Open the results sort control to choose an ordering.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "SelectFlights",
        "route": "/booking/flights"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  "cb-filters jb-select"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "list_cart",
      "description": "List the itineraries currently in the cart (both selected legs), read from the cart review page. Returns `items`: a list of objects with keys {itinerary}.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "Cart",
        "route": "/booking/cart"
      },
      "steps": [],
      "returns": {
        "kind": "list",
        "query": {
          "parts": [
            {
              "locators": [
                "cb-flight-selections cb-itinerary-panel"
              ]
            }
          ]
        },
        "fields": {
          "itinerary": {
            "property": "itinerary",
            "extractor": {
              "kind": "text"
            }
          }
        }
      },
      "guidance": [
        {
          "tool": "continue_to_checkout",
          "reason": "proceed to passenger details and payment",
          "when": "now"
        }
      ]
    },
    {
      "name": "continue_to_checkout",
      "description": "Proceed from the cart to checkout (passenger details + payment).",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "Cart",
        "route": "/booking/cart"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  "cb-price-summary .cb-price-summary__btn-checkout"
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "set_passenger",
          "reason": "fill the traveler-details fields (First Name, Last Name, Email, ...)",
          "when": "after_navigation",
          "view": "Checkout"
        }
      ]
    },
    {
      "name": "set_passenger",
      "description": "Fill a traveler-details field by its label (e.g. \"First Name\", \"Last Name\", \"Email address\").",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The field label, e.g. \"First Name\"."
          },
          "value": {
            "type": "string",
            "description": "The value to enter."
          }
        },
        "required": [
          "field",
          "value"
        ]
      },
      "ensureView": {
        "view": "Checkout",
        "route": "/booking/checkout"
      },
      "steps": [
        {
          "op": "fill",
          "query": {
            "parts": [
              {
                "locators": [
                  "jb-form-field-container"
                ],
                "preds": [
                  {
                    "property": "label",
                    "extractor": {
                      "kind": "text",
                      "within": "label"
                    },
                    "op": "*=",
                    "value": "{{field}}"
                  }
                ]
              },
              {
                "locators": [
                  "jb-form-field-container input",
                  "jb-form-field-container select"
                ]
              }
            ]
          },
          "value": "{{value}}"
        }
      ],
      "guidance": [
        {
          "tool": "continue_checkout_step",
          "reason": "advance to Seats \u0026 Extras, then payment",
          "when": "now"
        }
      ]
    },
    {
      "name": "continue_checkout_step",
      "description": "Advance to the next checkout step (Seats \u0026 Extras, then payment).",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "Checkout",
        "route": "/booking/checkout"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  "jb-checkout button.jb-button-primary"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
