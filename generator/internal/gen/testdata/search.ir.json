{
  "version": 1,
  "name": "search",
  "views": [
    {
      "name": "Search",
      "route": "/"
    },
    {
      "name": "Results",
      "route": "/results"
    }
  ],
  "tools": [
    {
      "name": "search",
      "description": "Run a search for a query. Navigates to the results page.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "What to search for."
          }
        },
        "required": [
          "query"
        ]
      },
      "ensureView": {
        "view": "Search",
        "route": "/"
      },
      "steps": [
        {
          "op": "fill",
          "query": {
            "parts": [
              {
                "locators": [
                  "#q"
                ]
              }
            ]
          },
          "value": "{{query}}"
        },
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  "#go"
                ]
              }
            ]
          }
        }
      ],
      "guidance": [
        {
          "tool": "list_results",
          "reason": "read the results the search produced",
          "when": "after_navigation",
          "view": "Results"
        }
      ]
    },
    {
      "name": "list_results",
      "description": "List the current search results (id, title, price). Returns `items`: a list of objects with keys {id, price, title}. The current results.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "Results",
        "route": "/results"
      },
      "steps": [],
      "returns": {
        "description": "The current results.",
        "kind": "list",
        "query": {
          "parts": [
            {
              "locators": [
                ".result"
              ]
            }
          ]
        },
        "fields": {
          "id": {
            "property": "id",
            "extractor": {
              "kind": "attr",
              "attr": "data-id"
            }
          },
          "price": {
            "property": "price",
            "extractor": {
              "kind": "text",
              "within": ".result-price"
            }
          },
          "title": {
            "property": "title",
            "extractor": {
              "kind": "text",
              "within": ".result-title"
            }
          }
        }
      },
      "guidance": [
        {
          "tool": "select_flight",
          "reason": "pick a flight by its id",
          "when": "now"
        }
      ]
    },
    {
      "name": "set_sort",
      "description": "Cycle the result sort order and return the reordered results. Returns `items`: a list of objects with keys {id, price, title}. The reordered results.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "Results",
        "route": "/results"
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  "#sort"
                ]
              }
            ]
          }
        }
      ],
      "returns": {
        "description": "The reordered results.",
        "kind": "list",
        "query": {
          "parts": [
            {
              "locators": [
                ".result"
              ]
            }
          ]
        },
        "fields": {
          "id": {
            "property": "id",
            "extractor": {
              "kind": "attr",
              "attr": "data-id"
            }
          },
          "price": {
            "property": "price",
            "extractor": {
              "kind": "text",
              "within": ".result-price"
            }
          },
          "title": {
            "property": "title",
            "extractor": {
              "kind": "text",
              "within": ".result-title"
            }
          }
        }
      }
    },
    {
      "name": "select_flight",
      "description": "Select a flight by id. Idempotent — selecting the same flight again is a no-op. Returns `value` (string): The selected flight summary.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {
          "flight_id": {
            "type": "string",
            "description": "The id of the result row to select."
          }
        },
        "required": [
          "flight_id"
        ]
      },
      "ensureView": {
        "view": "Results",
        "route": "/results"
      },
      "guard": {
        "kind": "present",
        "query": {
          "parts": [
            {
              "locators": [
                ".selection"
              ],
              "preds": [
                {
                  "property": "flight",
                  "extractor": {
                    "kind": "attr",
                    "attr": "data-selected"
                  },
                  "op": "=",
                  "value": "{{flight_id}}"
                }
              ]
            }
          ]
        }
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".result .result-select"
                ],
                "preds": [
                  {
                    "property": "flight",
                    "extractor": {
                      "kind": "attr",
                      "attr": "data-id"
                    },
                    "op": "=",
                    "value": "{{flight_id}}"
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "waitFor",
          "query": {
            "parts": [
              {
                "locators": [
                  ".selection"
                ],
                "preds": [
                  {
                    "property": "flight",
                    "extractor": {
                      "kind": "attr",
                      "attr": "data-selected"
                    },
                    "op": "=",
                    "value": "{{flight_id}}"
                  }
                ]
              }
            ]
          },
          "timeoutMs": 5000
        }
      ],
      "returns": {
        "description": "The selected flight summary.",
        "kind": "value",
        "query": {
          "parts": [
            {
              "locators": [
                ".selection"
              ],
              "preds": [
                {
                  "property": "flight",
                  "extractor": {
                    "kind": "attr",
                    "attr": "data-selected"
                  },
                  "op": "=",
                  "value": "{{flight_id}}"
                }
              ]
            }
          ]
        },
        "extractor": {
          "kind": "text"
        }
      },
      "guidance": [
        {
          "tool": "book",
          "reason": "book the selected flight",
          "when": "now"
        }
      ]
    },
    {
      "name": "book",
      "description": "Book the currently-selected flight. Idempotent — re-booking returns the existing reference. Returns `value` (string): The booking reference.",
      "mode": "live",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "ensureView": {
        "view": "Results",
        "route": "/results"
      },
      "guard": {
        "kind": "present",
        "query": {
          "parts": [
            {
              "locators": [
                ".booking-confirmation"
              ]
            }
          ]
        }
      },
      "steps": [
        {
          "op": "click",
          "query": {
            "parts": [
              {
                "locators": [
                  ".book-button"
                ]
              }
            ]
          }
        },
        {
          "op": "waitFor",
          "query": {
            "parts": [
              {
                "locators": [
                  ".booking-confirmation"
                ]
              }
            ]
          },
          "timeoutMs": 5000
        }
      ],
      "returns": {
        "description": "The booking reference.",
        "kind": "value",
        "query": {
          "parts": [
            {
              "locators": [
                ".booking-confirmation"
              ]
            }
          ]
        },
        "extractor": {
          "kind": "attr",
          "attr": "data-ref"
        }
      }
    }
  ]
}
